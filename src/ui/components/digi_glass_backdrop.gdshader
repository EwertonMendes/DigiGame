shader_type canvas_item;
render_mode unshaded;

// Real frosted-glass backdrop for Digi UI V2. The mipmapped screen texture is
// deliberately sampled at a higher LOD and with a small cross-kernel so the
// world behind the panel is optically blurred instead of merely darkened by
// transparency. This stays renderer-native and requires no external assets.
uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform vec2 screen_pixel_size = vec2(0.0005208333, 0.0009259259);
uniform vec4 glass_tint : source_color = vec4(0.03, 0.06, 0.09, 1.0);
uniform float blur_lod : hint_range(0.0, 5.0, 0.05) = 2.6;
uniform float blur_spread : hint_range(0.0, 3.0, 0.05) = 1.25;
uniform float saturation : hint_range(0.0, 1.25, 0.01) = 0.72;
uniform float brightness : hint_range(0.45, 1.20, 0.01) = 0.80;
uniform float frost : hint_range(0.0, 0.60, 0.01) = 0.20;
uniform float edge_style : hint_range(0.0, 1.0, 0.01) = 0.56;

float _max_channel(vec3 value) {
	return max(value.r, max(value.g, value.b));
}

vec3 _sample_frosted(vec2 uv) {
	// The mip level supplies the broad blur. Four inexpensive offset taps soften
	// recognizable sprites/tiles further without a large mobile/Web shader cost.
	// screen_pixel_size is supplied by the component because GLES3/Web does not
	// expose SCREEN_PIXEL_SIZE for this canvas shader path.
	vec2 spread = screen_pixel_size * exp2(blur_lod) * blur_spread;
	vec3 blurred = textureLod(screen_texture, uv, blur_lod).rgb * 0.36;
	blurred += textureLod(screen_texture, uv + vec2(spread.x, spread.y), blur_lod).rgb * 0.16;
	blurred += textureLod(screen_texture, uv + vec2(-spread.x, spread.y), blur_lod).rgb * 0.16;
	blurred += textureLod(screen_texture, uv + vec2(spread.x, -spread.y), blur_lod).rgb * 0.16;
	blurred += textureLod(screen_texture, uv - spread, blur_lod).rgb * 0.16;
	return blurred;
}

void fragment() {
	// COLOR is the StyleBoxFlat pixel generated by the PanelContainer. Keeping
	// its alpha preserves the rounded corners, border and shadow geometry, while
	// replacing the flat fill with an actual blurred capture of what is behind it.
	vec4 style_pixel = COLOR;
	vec3 blurred = _sample_frosted(SCREEN_UV);
	float luma = dot(blurred, vec3(0.299, 0.587, 0.114));
	blurred = mix(vec3(luma), blurred, saturation);

	vec3 glass = mix(blurred * brightness, glass_tint.rgb, frost);

	// StyleBox borders are considerably brighter than the dark center. Preserve
	// more of that source colour at the edge so semantic amber/cyan/red outlines
	// remain crisp while the center stays convincingly frosted.
	float border_hint = smoothstep(0.20, 0.52, _max_channel(style_pixel.rgb));
	float style_mix = mix(0.035, edge_style, border_hint);
	vec3 final_rgb = mix(glass, style_pixel.rgb, style_mix);

	// A small alpha lift keeps text readable over busy maps while still allowing
	// the blurred scene to read as material beneath the glass.
	float final_alpha = clamp(style_pixel.a + (1.0 - style_pixel.a) * 0.10, 0.0, 1.0);
	COLOR = vec4(final_rgb, final_alpha);
}
